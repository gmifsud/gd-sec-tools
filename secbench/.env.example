# Copy to .env (git-ignored). Read by Makefile (exported) and secbench.py/ingest.py via environment.
SECBENCH_MODE=observe

# Tier 2 — DefectDojo
DD_URL=http://127.0.0.1:8080
DD_API_KEY=                     # DD UI → user menu → API v2 Key
DD_MIN_SEVERITY=Info

# Tier 2 — Dependency-Track
DT_URL=http://127.0.0.1:8081
DT_API_KEY=                     # DT → Administration → Access Management → Teams → Automation → API keys
SECBENCH_DT_BRIDGE=0            # 1 = export DT findings (FPF) into DefectDojo after BOM upload

# ZAP auth header injection (never put tokens in context files)
ZAP_TOKEN=
