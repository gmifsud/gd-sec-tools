# images.src — human-maintained INPUT. Tags are deliberate choices, reviewed in PRs.
# scripts/pin-images.sh resolves each to an immutable digest and writes images.lock (the only file secbench.py reads).
# Never use :latest / :stable here. Bump a tag → re-run `make pin` → commit both files together.
#
# key=registry/image:tag              (registry images → resolved to image@sha256:…)
# key=build:<dir>                     (locally built → recorded as sha256:<image-id>)

# Tags reviewed 2026-11-12 (FB-02). Trivy: never 0.69.4-0.69.6 (CVE-2026-33634 / GHSA-69fq-xp46-6x23).
trivy=aquasec/trivy:0.76.2
gitleaks=ghcr.io/gitleaks/gitleaks:v8.30.1
zap=zaproxy/zap-stable:2.17.0
opengrep=build:docker/opengrep

# Tier 2 (management plane) — written to management-plane/images.env as IMAGE_<KEY>
# DefectDojo 2.x -> 3.x is a major jump: diff docker-compose.yml against the 3.5.101 release before mp-up (FB-08, FB-14).
dd-django=defectdojo/defectdojo-django:3.5.101
dd-nginx=defectdojo/defectdojo-nginx:3.5.101
# Dependency-Track stays on the 4.14 line: the Compose file is v4-shaped. v5 is a redesign; decide before WP-07 (FB-13).
dt-apiserver=dependencytrack/apiserver:4.14.6
dt-frontend=dependencytrack/frontend:4.14.6
postgres=postgres:16.9-alpine
redis=redis:7.4-alpine
